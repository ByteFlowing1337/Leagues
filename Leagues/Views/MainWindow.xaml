<Window x:Class="Leagues.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Leagues.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="Leagues" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Bottom">
            <MenuItem Header="Home"
                      Command="{Binding ShowHomeViewCommand}">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Home" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Match"
                      Command="{Binding ShowMatchViewCommand}">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="SwordCross" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Misc"
                      Command="{Binding ShowMiscViewCommand}">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="DotsHorizontal" />
                </MenuItem.Icon>
            </MenuItem>
        </Menu>

        <ContentControl Content="{Binding CurrentViewModel}"
                        Margin="24" />

    </DockPanel>
</Window>