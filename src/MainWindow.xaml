<Window x:Class="Leagues.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Leagues.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="Leagues" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <materialDesign:Card Padding="24" Width="300" Height="400" HorizontalAlignment="Center"
                             VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0 0 0 16" />

                <Button Content="Launch Client"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,0,12"
                        Visibility="{Binding LaunchClientVisibility}"
                        Command="{Binding LaunchClientCommand}" />

                <Button Content="{Binding AutoAcceptButtonText}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,0,12"
                        Visibility="{Binding FeatureButtonsVisibility}"
                        Command="{Binding ToggleAutoAcceptCommand}" />

                <Button Content="Decline Match"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Visibility="{Binding DeclineButtonVisibility}"
                        Command="{Binding DeclineMatchCommand}" />

                <Button Content="Accept Match"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Visibility="{Binding AcceptButtonVisibility}"
                        Command="{Binding AcceptMatchCommand}" />

                <Button Content="Match History"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,12,0,0"
                        Visibility="{Binding FeatureButtonsVisibility}"
                        Command="{Binding }" />

                <TextBlock Text="Runtime Log"
                           Margin="0,16,0,8"
                           Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />

                <Border Height="150"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource MaterialDesignDivider}">
                    <ListBox ItemsSource="{Binding LogEntries}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>