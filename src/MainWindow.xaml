<Window x:Class="Leagues.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Leagues"
        mc:Ignorable="d"
        Title="Leagues" Height="450" Width="800">
    <Grid>
        <TextBlock Name="TBHelloWorld" Text="Auto-Accept Disabled" FontSize="55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Name="acbtn" Content="Enable Auto-Accept" 
				HorizontalAlignment="Center"
				VerticalAlignment="Top" Width="200" Height="100"
				Click="Toggle_AC"/>
    </Grid>
</Window>
